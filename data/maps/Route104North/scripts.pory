mapscripts Route104North_MapScripts {
  MAP_SCRIPT_ON_TRANSITION: _Route104North_OnTransition
}

script _Route104North_OnTransition {
  call(Route104_EventScript_ShowOrHideWhiteHerbFlorist)
  end
}

script _Route104North_EventScript_ExpertF {
  lock
  faceplayer
  if (!flag(FLAG_RECEIVED_BERRY_ROUTE_104)) {
    msgbox(format("If you see Berries growing in loamy soil, feel free to take them.\p But, make sure you plant a Berry in the same spot. That's common courtesy.\p Here, I'll share these with you."))
    giveitem(ITEM_CHARTI_BERRY, 3)
    if (!var(VAR_RESULT)) { goto(Common_EventScript_ShowBagIsFull) }
    setflag(FLAG_RECEIVED_BERRY_ROUTE_104)
  }
  msgbox(format("The way you look, you must be a Trainer, no?\p Trainers often make Pokémon hold Berries.\p It's up to you whether to grow Berries or use them."))
  release
  end
}

script _Route104North_EventScript_GiveTMEchoedVoice {
  lock
  faceplayer
  if(!flag(FLAG_RECEIVED_TM_ECHOED_VOICE)) {
    msgbox(format("Wassup!\nI like to shout my lungs out!\N It feels so good!\p You can have this, so you try it out!\p Use it on a Pokémon, and it will learn a move that attacks with its voice.\p If the move is used several times in a row, it becomes more powerful!"))
    giveitem(ITEM_TM_ECHOED_VOICE)
    if (!var(VAR_RESULT)) { goto(Common_EventScript_ShowBagIsFull) }
    setflag(FLAG_RECEIVED_TM_ECHOED_VOICE)
  }
  msgbox(format("A word of advice!\N A TM, or Technical Machine, can be used many times.\p It won't go away.\N So try it out as many times as you want!"))
  release
  end
}

script Route104North_EventScript_WhiteHerbFlorist {
  lock
  faceplayer
  if (!flag(FLAG_VISITED_DEWFORD_TOWN)) {
    if (!flag(FLAG_MET_WHITE_HERB_FLORIST)) {
      msgbox(format("This Flower Shop started selling Mulch and saplings recently.\p It made me so happy, I went overboard shopping.\p I don't need so many of these berries, could I heal your Pokémon with some of them please?"), MSGBOX_YESNO)
      setflag(FLAG_MET_WHITE_HERB_FLORIST)
    } else {
      msgbox(format("Hey there! I still have too many berries, can I heal your Pokémon for you again?"), MSGBOX_YESNO)
    }
    if (!var(VAR_RESULT)) {
      msgbox(format("Well, what am I gonna do with all these berries then?"))
      release
      end
    }
    msgbox(format("Oh, thank you so much!"))
    closemessage
    call(Common_EventScript_OutOfCenterPartyHeal)
    msgbox(format("All healed up!\N There's lots of icky bugs in Petalburg Woods, so make sure your Pokémon stay healthy!"))
  } else {
    msgbox(format("Thanks for helping me out! Now I just have a sane amount of berries. Haha!"))
  }
  release
  end
}
