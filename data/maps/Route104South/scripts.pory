mapscripts Route104South_MapScripts {
  MAP_SCRIPT_ON_FRAME_TABLE [
    VAR_BOARD_BRINEY_BOAT_STATE, 1: _Route104South_EventScript_StartSailToDewford
  ]
  MAP_SCRIPT_ON_TRANSITION: _Route104South_OnTransition
}

script _Route104South_EventScript_StartSailToDewford {
  lockall
  goto(Route104_EventScript_SailToDewford)
  end
}

script _Route104South_OnTransition {
  call(Common_EventScript_SetupRivalGfxId)
  call(_Route104South_EventScript_TrySetRivalPos)
  end
}

script _Route104South_EventScript_TrySetRivalPos {
  if (var(VAR_BOARD_BRINEY_BOAT_STATE) >= 1) {
    goto(Route104_EventScript_DontSetRivalPos)
  }
  if (flag(FLAG_MET_RIVAL_RUSTBORO)) {
    goto(Route104_EventScript_DontSetRivalPos)
  }
  if (!flag(FLAG_REGISTER_RIVAL_POKENAV)) {
    goto(Route104_EventScript_DontSetRivalPos)
  }
  setobjectxyperm(LOCALID_ROUTE104SOUTH_RIVAL, 17, 20)
  return
}

const EXCLAMATION_MARKED = VAR_TEMP_7

script _Route104South_EventScript_RivalTrigger {
  lockall
  setflag(FLAG_HIDE_RUSTBORO_CITY_RIVAL)
  setorcopyvar(VAR_RUSTBORO_CITY_STATE, 8)
  setorcopyvar(VAR_ROUTE104_STATE, 2)
  applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkInPlaceFasterUp)
  waitmovement(0)
  delay(10)
  addobject(LOCALID_ROUTE104SOUTH_RIVAL)
  clearflag(FLAG_HIDE_ROUTE_104_RIVAL)
  applymovement(OBJ_EVENT_ID_PLAYER, Route104_Movement_PlayerBackUp)
  waitmovement(0)
  applymovement(LOCALID_ROUTE104SOUTH_RIVAL, Route104_Movement_RivalExitBrineysCottage)
  waitmovement(0)
  delay(20)
  setorcopyvar(VAR_0x8008, 0)
  call(RustboroCity_EventScript_PlayRivalMusic)
  setorcopyvar(EXCLAMATION_MARKED, LOCALID_ROUTE104SOUTH_RIVAL)
  call(_Common_EventScript_ExclamationMark)
  goto(_Route104South_EventScript_RivalEncounter)
}

const STARTER_GRASS = 0
const STARTER_FIRE  = 1
const STARTER_WATER = 2

script _Route104South_EventScript_RivalEncounter {
  if (!flag(FLAG_DEFEATED_RIVAL_ROUTE_104)) {
    if (flag(FLAG_REGISTER_RIVAL_POKENAV)) {
      if (checkplayergender == MALE) { goto(Route104_EventScript_MayAskToBattle) }
      else { goto(Route104_EventScript_BrendanAskToBattle) }
    }
    setflag(FLAG_REGISTER_RIVAL_POKENAV)
    if (checkplayergender == MALE) { msgbox(Route104_Text_MayWeShouldRegister) }
    else { msgbox(Route104_Text_BrendanWeShouldRegister)}
    closemessage
    delay(30)
    playfanfare(MUS_REGISTER_MATCH_CALL)
    if (checkplayergender == MALE) { msgbox(Route104_Text_RegisteredMay) }
    else { msgbox(Route104_Text_RegisteredBrendan) }
    waitfanfare
    closemessage
    delay(30)
    setflag(FLAG_ENABLE_RIVAL_MATCH_CALL)
    applymovement(OBJ_EVENT_ID_PLAYER, Route104_Movement_PlayerFaceRival)
    applymovement(LOCALID_ROUTE104SOUTH_RIVAL, Route104_Movement_RivalWalkSlowLeft)
    if (checkplayergender == MALE) { msgbox(Route104_Text_MayHowsYourPokedex) }
    else { msgbox(Route104_Text_BrendanHowsYourPokedex) }
    closemessage
    waitmovement(0)
    applymovement(LOCALID_ROUTE104SOUTH_RIVAL, Route104_Movement_RivalApproachPlayer)
    waitmovement(0)
    copyobjectxytoperm(LOCALID_ROUTE104SOUTH_RIVAL)
    if (checkplayergender == MALE) {
      msgbox(format("Mine's looking pretty decent.\N So…\N How about a little battle?"))
    } else {
      msgbox(format("Me, I'm doing great!\p Wanna check out how good I am with a battle?"))
    }
    if (checkplayergender == MALE) {
      switch(var(VAR_STARTER_MON)) {
        case STARTER_GRASS:
          trainerbattle_no_intro(TRAINER_MAY_RUSTBORO_TREECKO, Route104_Text_MayDefeat)
        case STARTER_FIRE:
          trainerbattle_no_intro(TRAINER_MAY_RUSTBORO_TORCHIC, Route104_Text_MayDefeat)
        case STARTER_WATER:
          trainerbattle_no_intro(TRAINER_MAY_RUSTBORO_MUDKIP, Route104_Text_MayDefeat)
      }
    } else {
      switch(var(VAR_STARTER_MON)) {
        case STARTER_GRASS:
          trainerbattle_no_intro(TRAINER_BRENDAN_RUSTBORO_TREECKO, Route104_Text_BrendanDefeat)
        case STARTER_FIRE:
          trainerbattle_no_intro(TRAINER_BRENDAN_RUSTBORO_TORCHIC, Route104_Text_BrendanDefeat)
        case STARTER_WATER:
          trainerbattle_no_intro(TRAINER_BRENDAN_RUSTBORO_MUDKIP, Route104_Text_BrendanDefeat)
      }
    }
    call(_Route104South_EventScript_RivalDefeatedRaiseLevelCap)
    setflag(FLAG_DEFEATED_RIVAL_ROUTE_104)
  }
  if (checkplayergender == MALE) { msgbox(Route104_Text_MayPostBattle) }
  else { msgbox(Route104_Text_BrendanPostBattle) }
  if (var(VAR_0x8008) == 0) { call(Route104_EventScript_RestoreMusic) }
  releaseall
  end
}
