const ITEM_FOUND = VAR_0x8005

script _Common_EventScript_RandomizedItemHidden {
  if (var(ITEM_FOUND) == ITEM_POKE_BALL     ||
      var(ITEM_FOUND) == ITEM_GREAT_BALL    ||
      var(ITEM_FOUND) == ITEM_ULTRA_BALL    ||
      var(ITEM_FOUND) == ITEM_MASTER_BALL   ||
      var(ITEM_FOUND) == ITEM_DIVE_BALL     ||
      var(ITEM_FOUND) == ITEM_LUXURY_BALL   ||
      var(ITEM_FOUND) == ITEM_NET_BALL      ||
      var(ITEM_FOUND) == ITEM_NEST_BALL     ||
      var(ITEM_FOUND) == ITEM_REPEAT_BALL   ||
      var(ITEM_FOUND) == ITEM_TIMER_BALL) {
    call(_Common_EventScript_RandomizedItemHidden_Generic)
  }
  if (var(ITEM_FOUND) == ITEM_POTION        ||
      var(ITEM_FOUND) == ITEM_SUPER_POTION  ||
      var(ITEM_FOUND) == ITEM_HYPER_POTION  ||
      var(ITEM_FOUND) == ITEM_MAX_POTION    ||
      var(ITEM_FOUND) == ITEM_FULL_RESTORE  ||
      var(ITEM_FOUND) == ITEM_ENERGY_POWDER ||
      var(ITEM_FOUND) == ITEM_ENERGY_ROOT) {
    call(_Common_EventScript_RandomizedItemHidden_HerbalMedicinesExtended)
  }
  if (var(ITEM_FOUND) == ITEM_ANTIDOTE      ||
      var(ITEM_FOUND) == ITEM_AWAKENING     ||
      var(ITEM_FOUND) == ITEM_BURN_HEAL     ||
      var(ITEM_FOUND) == ITEM_ICE_HEAL      ||
      var(ITEM_FOUND) == ITEM_PARALYZE_HEAL ||
      var(ITEM_FOUND) == ITEM_FULL_HEAL     ||
      var(ITEM_FOUND) == ITEM_HEAL_POWDER) {
    call(_Common_EventScript_RandomizedItemHidden_HerbalMedicinesExtended)
  }
  if (var(ITEM_FOUND) == ITEM_REVIVE        ||
      var(ITEM_FOUND) == ITEM_MAX_REVIVE    ||
      var(ITEM_FOUND) == ITEM_REVIVAL_HERB) {
    call(_Common_EventScript_RandomizedItemHidden_HerbalMedicinesExtended)
  }
  if (var(ITEM_FOUND) == ITEM_ETHER         ||
      var(ITEM_FOUND) == ITEM_ELIXIR        ||
      var(ITEM_FOUND) == ITEM_MAX_ETHER     ||
      var(ITEM_FOUND) == ITEM_MAX_ELIXIR) {
    call(_Common_EventScript_RandomizedItemHidden_Generic)
  }
  if (var(ITEM_FOUND) == ITEM_PROTEIN       ||
      var(ITEM_FOUND) == ITEM_IRON          ||
      var(ITEM_FOUND) == ITEM_CALCIUM       ||
      var(ITEM_FOUND) == ITEM_ZINC          ||
      var(ITEM_FOUND) == ITEM_CARBOS        ||
      var(ITEM_FOUND) == ITEM_HP_UP         ||
      var(ITEM_FOUND) == ITEM_PP_UP         ||
      var(ITEM_FOUND) == ITEM_PP_MAX) {
    call(_Common_EventScript_RandomizedItemHidden_Generic)
  }
  if (var(ITEM_FOUND) == ITEM_X_ATTACK      ||
      var(ITEM_FOUND) == ITEM_X_DEFENSE     ||
      var(ITEM_FOUND) == ITEM_X_SP_ATK      ||
      var(ITEM_FOUND) == ITEM_X_SP_DEF      ||
      var(ITEM_FOUND) == ITEM_X_SPEED       ||
      var(ITEM_FOUND) == ITEM_X_ACCURACY    ||
      var(ITEM_FOUND) == ITEM_GUARD_SPEC    ||
      var(ITEM_FOUND) == ITEM_DIRE_HIT) {
    call(_Common_EventScript_RandomizedItemHidden_Generic)
  }
  if (var(ITEM_FOUND) == ITEM_RED_SHARD     ||
      var(ITEM_FOUND) == ITEM_BLUE_SHARD    ||
      var(ITEM_FOUND) == ITEM_GREEN_SHARD   ||
      var(ITEM_FOUND) == ITEM_YELLOW_SHARD  ||
      var(ITEM_FOUND) == ITEM_HEART_SCALE   ||
      var(ITEM_FOUND) == ITEM_PEARL         ||
      var(ITEM_FOUND) == ITEM_BIG_PEARL) {
    call(_Common_EventScript_RandomizedItemHidden_PearlsExtended)
  }
  if (var(ITEM_FOUND) == ITEM_TINY_MUSHROOM ||
      var(ITEM_FOUND) == ITEM_BIG_MUSHROOM) {
    call(_Common_EventScript_RandomizedItemHidden_Mushrooms)
  }
  if (var(ITEM_FOUND) == ITEM_NUGGET        ||
      var(ITEM_FOUND) == ITEM_BIG_NUGGET) {
    call(_Common_EventScript_RandomizedItemHidden_NuggetsExtended)
  }
  if (var(ITEM_FOUND) == ITEM_STARDUST      ||
      var(ITEM_FOUND) == ITEM_STAR_PIECE) {
    call(_Common_EventScript_RandomizedItemHidden_Generic)
  }
}

script _Common_EventScript_RandomizedItemHidden_Generic {
  switch (random(4)) {
    case 0: call(_Common_EventScript_RandomizedItemHidden_Feathers)
    case 1: call(_Common_EventScript_RandomizedItemHidden_Stardusts)
    case 2: call(_Common_EventScript_RandomizedItemHidden_HeldItemsTypeBoosting)
    case 3: call(_Common_EventScript_RandomizedItemHidden_HeldItemsFancy)
  }
}

script _Common_EventScript_RandomizedItemHidden_HerbalMedicinesExtended {
  if (randompercentage(50)) {
    call(_Common_EventScript_RandomizedItemHidden_HerbalMedicines)
  } else {
    switch (random(2)) {
      case 0: call(_Common_EventScript_RandomizedItemHidden_BambooShoots)
      case 1: call(_Common_EventScript_RandomizedItemHidden_HeldItemsHerbs)
    }
  }
}

script _Common_EventScript_RandomizedItemHidden_NuggetsExtended {
  if (randompercentage(67)) {
    call(_Common_EventScript_RandomizedItemHidden_Nuggets)
  } else {
    call(_Common_EventScript_RandomizedItemHidden_Fossils)
  }
}

script _Common_EventScript_RandomizedItemHidden_PearlsExtended {
  if (randompercentage(67)) {
    call(_Common_EventScript_RandomizedItemHidden_Pearls)
  } else {
    call(_Common_EventScript_RandomizedItemHidden_Fossils)
  }
}

script _Common_EventScript_RandomizedItemHidden_BambooShoots {
  if (randompercentage(25)) {
    setorcopyvar(ITEM_FOUND, ITEM_TINY_BAMBOO_SHOOT)
  } else {
    setorcopyvar(ITEM_FOUND, ITEM_BIG_BAMBOO_SHOOT)
  }
}

script _Common_EventScript_RandomizedItemHidden_Feathers {
  // randomelement(
    // ITEM_HEALTH_FEATHER,
    // ITEM_MUSCLE_FEATHER,
    // ITEM_RESIST_FEATHER,
    // ITEM_GENIUS_FEATHER,
    // ITEM_CLEVER_FEATHER,
    // ITEM_SWIFT_FEATHER,
    // ITEM_PRETTY_FEATHER
  // )
  // setorcopyvar(ITEM_FOUND, VAR_RESULT)
  setorcopyvar(ITEM_FOUND, ITEM_PRETTY_FEATHER)
}

script _Common_EventScript_RandomizedItemHidden_Fossils {
  if (randompercentage(10)) {
    setorcopyvar(ITEM_FOUND, ITEM_OLD_AMBER)
  } else {
    randomelement(
      ITEM_HELIX_FOSSIL,
      ITEM_DOME_FOSSIL,
      ITEM_ROOT_FOSSIL,
      ITEM_CLAW_FOSSIL
    )
    setorcopyvar(ITEM_FOUND, VAR_RESULT)
  }
}

script _Common_EventScript_RandomizedItemHidden_HeldItemsFancy {
  randomelement(
    ITEM_LUCKY_EGG,
    // ITEM_DESTINY_KNOT,
    ITEM_LEFTOVERS,
    // ITEM_DEEP_SEA_SCALE,
    // ITEM_DEEP_SEA_TOOTH,
    ITEM_DRAGON_SCALE,
    ITEM_ELECTIRIZER,
    ITEM_KINGS_ROCK,
    ITEM_MAGMARIZER,
    ITEM_METAL_COAT,
    ITEM_OVAL_STONE,
    ITEM_PROTECTOR,
    ITEM_RAZOR_CLAW,
    ITEM_RAZOR_FANG,
    // ITEM_PRISM_SCALE,
    ITEM_REAPER_CLOTH
  )
  setorcopyvar(ITEM_FOUND, VAR_RESULT)
}

script _Common_EventScript_RandomizedItemHidden_HeldItemsHerbs {
  randomelement(
    ITEM_MENTAL_HERB,
    ITEM_POWER_HERB,
    ITEM_WHITE_HERB
  )
  setorcopyvar(ITEM_FOUND, VAR_RESULT)
}

script _Common_EventScript_RandomizedItemHidden_HeldItemsTypeBoosting {
  randomelement(
    ITEM_SILK_SCARF,
    ITEM_CHARCOAL,
    ITEM_MYSTIC_WATER,
    ITEM_MAGNET,
    ITEM_MIRACLE_SEED,
    ITEM_NEVER_MELT_ICE,
    ITEM_BLACK_BELT,
    ITEM_POISON_BARB,
    ITEM_SOFT_SAND,
    ITEM_SHARP_BEAK,
    ITEM_TWISTED_SPOON,
    ITEM_SILVER_POWDER,
    ITEM_HARD_STONE,
    ITEM_SPELL_TAG,
    ITEM_DRAGON_FANG,
    ITEM_BLACK_GLASSES,
    ITEM_METAL_COAT,
    ITEM_FAIRY_FEATHER
  )
  setorcopyvar(ITEM_FOUND, VAR_RESULT)
}

script _Common_EventScript_RandomizedItemHidden_HerbalMedicines {
  setorcopyvar(ITEM_FOUND, VAR_RESULT)
  if (randompercentage(50)) {
    randomelement(
      ITEM_ENERGY_POWDER,
      ITEM_ENERGY_ROOT
    )
    setorcopyvar(ITEM_FOUND, VAR_RESULT)
  } else {
    randomelement(
      ITEM_REVIVAL_HERB,
      ITEM_HEAL_POWDER
    )
    setorcopyvar(ITEM_FOUND, VAR_RESULT)
  }
}

script _Common_EventScript_RandomizedItemHidden_Mushrooms {
  if (randompercentage(25)) {
    setorcopyvar(ITEM_FOUND, ITEM_TINY_MUSHROOM)
  } else {
    randomelement(
      ITEM_BIG_MUSHROOM,
      ITEM_BALM_MUSHROOM
    )
    setorcopyvar(ITEM_FOUND, VAR_RESULT)
  }
}

script _Common_EventScript_RandomizedItemHidden_Nuggets {
  if (randompercentage(25)) {
    setorcopyvar(ITEM_FOUND, ITEM_BIG_NUGGET)
  } else {
    setorcopyvar(ITEM_FOUND, ITEM_NUGGET)
  }
}

script _Common_EventScript_RandomizedItemHidden_Pearls {
  if (randompercentage(25)) {
    setorcopyvar(ITEM_FOUND, ITEM_BIG_PEARL)
  } else {
    setorcopyvar(ITEM_FOUND, ITEM_PEARL)
  }
}

script _Common_EventScript_RandomizedItemHidden_Stardusts {
  if (randompercentage(50)) {
    setorcopyvar(ITEM_FOUND, ITEM_STAR_PIECE)
  } else {
    randomelement(
      ITEM_STARDUST,
      ITEM_COMET_SHARD
    )
    setorcopyvar(ITEM_FOUND, VAR_RESULT)
  }
}
