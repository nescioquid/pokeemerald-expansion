const BERRY_AMOUNT = VAR_TEMP_0

script _Common_EventScript_GiveBerry_Generic {
  if (randompercentage(25)) {
    randomelement(3, 2, 1, 1)
    setorcopyvar(BERRY_AMOUNT, VAR_RESULT)
    giveitem(ITEM_LEPPA_BERRY, BERRY_AMOUNT)
    if (!var(VAR_RESULT)) { goto(Common_EventScript_ShowBagIsFull) }
  } else {
    switch (random(5)) {
      case 0: call(_Common_EventScript_GiveBerry_Confuse)
      case 1: call(_Common_EventScript_GiveBerry_HP)
      case 2: call(_Common_EventScript_GiveBerry_RaiseStats)
      case 3: call(_Common_EventScript_GiveBerry_Resistance)
      case 4: call(_Common_EventScript_GiveBerry_Retaliatory)
    }
  }
}

script _Common_EventScript_GiveBerry_Confuse {
  randomelement(4, 3, 2, 1)
  setorcopyvar(BERRY_AMOUNT, VAR_RESULT)
  randomelement(
    ITEM_FIGY_BERRY,
    ITEM_WIKI_BERRY,
    ITEM_MAGO_BERRY,
    ITEM_AGUAV_BERRY,
    ITEM_IAPAPA_BERRY
  )
  giveitem(VAR_RESULT, BERRY_AMOUNT)
  if (!var(VAR_RESULT)) { goto(Common_EventScript_ShowBagIsFull) }
}

script _Common_EventScript_GiveBerry_HP {
  randomelement(4, 3, 2, 1)
  setorcopyvar(BERRY_AMOUNT, VAR_RESULT)
  randomelement(
    ITEM_ORAN_BERRY,
    ITEM_SITRUS_BERRY
  )
  giveitem(VAR_RESULT, BERRY_AMOUNT)
  if (!var(VAR_RESULT)) { goto(Common_EventScript_ShowBagIsFull) }
}

