script _Common_EventScript_GiveBerry_Retaliatory {
  randomelement(4, 3, 2, 1)
  setorcopyvar(BERRY_AMOUNT, VAR_RESULT)
  randomelement(
    ITEM_CUSTAP_BERRY,
    // ITEM_JABOCA_BERRY,
    // ITEM_ROWAP_BERRY, 
    ITEM_KEE_BERRY,
    ITEM_MARANGA_BERRY
  )
  giveitem(VAR_RESULT, BERRY_AMOUNT)
  if (!var(VAR_RESULT)) { goto(Common_EventScript_ShowBagIsFull) }
}

script _Common_EventScript_GiveBerry_Status {
  randomelement(4, 3, 2, 1)
  setorcopyvar(BERRY_AMOUNT, VAR_RESULT)
  if (randompercentage(67)) {
    randomelement(
      ITEM_CHERI_BERRY,
      ITEM_CHESTO_BERRY,
      ITEM_PECHA_BERRY,
      ITEM_RAWST_BERRY,
      ITEM_ASPEAR_BERRY,
      ITEM_PERSIM_BERRY
    )
  } else {
    setorcopyvar(VAR_RESULT, ITEM_LUM_BERRY)
  }
  giveitem(VAR_RESULT, BERRY_AMOUNT)
  if (!var(VAR_RESULT)) { goto(Common_EventScript_ShowBagIsFull) }
}
