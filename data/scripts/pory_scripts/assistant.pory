const LEVEL_CAP  = VAR_TEMP_1
const VERSION    = VAR_TEMP_2
const PRE_LVLCAP = VAR_TEMP_3
const PARTY_MON  = VAR_TEMP_4
const MON_STAT   = VAR_TEMP_5

script Pokemon_Center_Assistant {
    lock
    faceplayer
    call(Assistant_Hello)
    waitmessage
    call(Assistant_CheckBadges)
    call(Assistant_Goodbye)
    release
    end
}

script Assistant_Hello {
    if (!flag(FLAG_MET_ASSISTANT)) {
        msgbox(format("Hello!\n
            I am here to assist you as you progress in your Pokémon journey!\n
            Forgive me, but I too am just starting my journey as an assistant, \n
            so I might not be able to help you much right now,\n
            but I promise I will learn as I go!\n
            How may I help you today?\$"))
        setflag(FLAG_MET_ASSISTANT)
    }
    else {
        msgbox(format("Hello again!\n How may I help you today?"))
    }
}

script Assistant_CheckBadges {
    if (!flag(FLAG_SYS_GAME_CLEAR)) {
        call(_Common_EventScript_GetBadgeCount)
        switch(var(VAR_RESULT)) {
            case 0: call(Assistant_ZeroBadges)
            case 1: call(Assistant_OneBadge)
            case 2: call(Assistant_TwoBadges)
            case 3: call(Assistant_ThreeBadges)
            case 4: call(Assistant_FourBadges)
            case 5: call(Assistant_FiveBadges)
            case 6: call(Assistant_SixBadges)
            case 7: call(Assistant_SevenBadges)
            case 8: call(Assistant_EightBadges)
        }
    }
    else {
        call(Assistant_Postgame)
    }
}

script Assistant_Goodbye {
    switch (random(9)) {
        case 0: msgbox(format("See you later!"))
        case 1: msgbox(format("Goodbye!"))
        case 2: msgbox(format("Bye bye!"))
        case 3: msgbox(format("Bye now!"))
        case 4: msgbox(format("Bye!"))
        case 5: msgbox(format("Ciao!"))
        case 6: msgbox(format("Have fun out there!"))
        case 7: msgbox(format("Good luck!"))
        case 8: msgbox(format("You'll do great!"))
    }
}

script Assistant_ZeroBadges {
    dynmultipush("Current Level Cap",0)
    dynmultipush("Version Info",1)
    dynmultistack(0, 0, FALSE, 5, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
    if (var(VAR_RESULT) == MULTI_B_PRESSED) {
        return
    }
    switch (var(VAR_RESULT)){
        case 0: call(CurrentLevelCap)
        case 1: call(VersionInfo)
    }
}

script Assistant_OneBadge {
    call(Assistant_ZeroBadges)
}

// Adds ability to set pokemon to previous level cap.
script Assistant_TwoBadges {
    dynmultipush("Current Level Cap",0)
    dynmultipush("Version Info",1)
    dynmultipush("Set Mon to Prev Lvl Cap",2)
    dynmultistack(0, 0, FALSE, 5, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
    if (var(VAR_RESULT) == MULTI_B_PRESSED) {
        return
    }
    switch (var(VAR_RESULT)){
        case 0: call(CurrentLevelCap)
        case 1: call(VersionInfo)
        case 2: call(SetMontoPrevLvlCap)
    }
}

// Sets friendship level.
script Assistant_ThreeBadges {
    dynmultipush("Current Level Cap",0)
    dynmultipush("Version Info",1)
    dynmultipush("Set Mon to Prev Lvl Cap",2)
    dynmultipush("Maxize Friendship",3)
    dynmultistack(0, 0, FALSE, 5, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
    if (var(VAR_RESULT) == MULTI_B_PRESSED) {
        return
    }
    switch (var(VAR_RESULT)){
        case 0: call(CurrentLevelCap)
        case 1: call(VersionInfo)
        case 2: call(SetMontoPrevLvlCap)
        case 3: call(MaxFriendship)
    }
}

script Assistant_FourBadges {
    call(Assistant_ThreeBadges)
}

script Assistant_FiveBadges {
    call(Assistant_ThreeBadges)
}

// Adds Nature Change.
script Assistant_SixBadges {
    dynmultipush("Current Level Cap",0)
    dynmultipush("Version Info",1)
    dynmultipush("Set Mon to Prev Lvl Cap",2)
    dynmultipush("Maxize Friendship",3)
    dynmultipush("Change Nature", 4)
    dynmultistack(0, 0, FALSE, 5, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
    if (var(VAR_RESULT) == MULTI_B_PRESSED) {
        return
    }
    switch (var(VAR_RESULT)){
        case 0: call(CurrentLevelCap)
        case 1: call(VersionInfo)
        case 2: call(SetMontoPrevLvlCap)
        case 3: call(MaxFriendship)
        case 4: call(NatureChange)
    }
}

// Adds ability to reset EVs.
script Assistant_SevenBadges {
    dynmultipush("Current Level Cap",0)
    dynmultipush("Version Info",1)
    dynmultipush("Set Mon to Prev Lvl Cap",2)
    dynmultipush("Maxize Friendship",3)
    dynmultipush("Change Nature", 4)
    dynmultipush("Reset EVs", 5)
    dynmultistack(0, 0, FALSE, 5, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
    if (var(VAR_RESULT) == MULTI_B_PRESSED) {
        return
    }
    switch (var(VAR_RESULT)){
        case 0: call(CurrentLevelCap)
        case 1: call(VersionInfo)
        case 2: call(SetMontoPrevLvlCap)
        case 3: call(MaxFriendship)
        case 4: call(NatureChange)
        case 5: call(ResetEVs)
    }
}

// Adds Gender Swap.
// Can lower IV to 0 (for things like Trick Room).
script Assistant_EightBadges {
    dynmultipush("Current Level Cap",0)
    dynmultipush("Version Info",1)
    dynmultipush("Set Mon to Prev Lvl Cap",2)
    dynmultipush("Maxize Friendship",3)
    dynmultipush("Change Nature", 4)
    dynmultipush("Reset EVs", 5)
    dynmultipush("Swap Gender", 6)
    dynmultipush("Lower IVs", 7)
    dynmultistack(0, 0, FALSE, 5, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
    if (var(VAR_RESULT) == MULTI_B_PRESSED) {
        return
    }
    switch (var(VAR_RESULT)){
        case 0: call(CurrentLevelCap)
        case 1: call(VersionInfo)
        case 2: call(SetMontoPrevLvlCap)
        case 3: call(MaxFriendship)
        case 4: call(NatureChange)
        case 5: call(ResetEVs)
        case 6: call(SwapGender)
        case 7: call(LowerIVs)
    }
}

script Assistant_Postgame {
    call(Assistant_EightBadges)
}

script CurrentLevelCap {
    // TODO call var that represents lvl cap
    copyvar(LEVEL_CAP, VAR_0x8004)
    buffernumberstring (STR_VAR_1, LEVEL_CAP)
    msgbox(format("The current level cap is {STR_VAR_1}."))
    release
    end
}

script VersionInfo {
    // TODO call var that represents version info
    copyvar(VERSION, VAR_0x8004)
    bufferstdstring (STR_VAR_1, VERSION)
    msgbox(format("Version: {STR_VAR_1}"))
    release
    end
}

script SetMontoPrevLvlCap {
    special(ChoosePartyMon)
    waitstate
    if (var(VAR_0x8004) == PARTY_NOTHING_CHOSEN) {
        release
        end
    }
    copyvar(PARTY_MON, VAR_0x8004)
    bufferpartymonnick(STR_VAR_1, PARTY_MON)
    // TODO call var representing lvl cap minus 1
    copyvar(PRE_LVLCAP, VAR_0x8004)
    buffernumberstring (STR_VAR_2, PRE_LVLCAP)
    // TODO change mon level
    msgbox(format("I have set {STR_VAR_1} to level {STR_VAR_2}!"))
    closemessage
    release
    end
}

script MaxFriendship {
    special(ChoosePartyMon)
    waitstate
    if (var(VAR_0x8004) == PARTY_NOTHING_CHOSEN) {
        release
        end
    }
    copyvar(PARTY_MON, VAR_0x8004)
    bufferpartymonnick(STR_VAR_1, PARTY_MON)
    // TODO set Friendship to FRIENDSHIP_MAX
    msgbox(format("{STR_VAR_1} is the happiest they will ever be!"))
    closemessage
    release
    end
}

script NatureChange {
    msgbox(format("Which Pokémon?"))
    special(ChoosePartyMon)
    waitstate
    if (var(VAR_0x8004) == PARTY_NOTHING_CHOSEN) {
        release
        end
    }
    copyvar(PARTY_MON, VAR_0x8004)
    bufferpartymonnick(STR_VAR_1,PARTY_MON)
    msgbox(format("Which new nature best serves {STR-VAR_1}?"))
    // Numbered based on pokemon.h file that numbers natures.
    dynmultipush("Adamant{CLEAR_TO 0x48}{FONT_RED}+Atk{FONT_NORMAL}/{FONT_BLUE}-SpAtk",3)
    dynmultipush("Bashful{CLEAR_TO 0x48}Neutral",18)
    dynmultipush("Bold   {CLEAR_TO 0x48}{FONT_RED}+Def{FONT_NORMAL}/{FONT_BLUE}-Atk",5)
    dynmultipush("Brave  {CLEAR_TO 0x48}{FONT_RED}+Atk{FONT_NORMAL}/{FONT_BLUE}-Speed",2)
    dynmultipush("Calm   {CLEAR_TO 0x48}{FONT_RED}+SpDef{FONT_NORMAL}/{FONT_BLUE}-Atk",20)
    dynmultipush("Careful{CLEAR_TO 0x48}{FONT_RED}+SpDef{FONT_NORMAL}/{FONT_BLUE}-SpAtk",23)
    dynmultipush("Docile {CLEAR_TO 0x48}Neutral",6)
    dynmultipush("Gentle {CLEAR_TO 0x48}{FONT_RED}+SpDef{FONT_NORMAL}/{FONT_BLUE}-Def",21)
    dynmultipush("Hardy  {CLEAR_TO 0x48}Neutral",0)
    dynmultipush("Hasty  {CLEAR_TO 0x48}{FONT_RED}+Speed{FONT_NORMAL}/{FONT_BLUE}-Def",11)
    dynmultipush("Impish {CLEAR_TO 0x48}{FONT_RED}+Def{FONT_NORMAL}/{FONT_BLUE}-SpAtk",8)
    dynmultipush("Jolly  {CLEAR_TO 0x48}{FONT_RED}+Speed{FONT_NORMAL}/{FONT_BLUE}-SpAtk",13)
    dynmultipush("Lax    {CLEAR_TO 0x48}{FONT_RED}+Def{FONT_NORMAL}/{FONT_BLUE}-SpDef",9)
    dynmultipush("Lonely {CLEAR_TO 0x48}{FONT_RED}+Atk{FONT_NORMAL}/{FONT_BLUE}-Def",1)
    dynmultipush("Mild   {CLEAR_TO 0x48}{FONT_RED}+SpAtk{FONT_NORMAL}/{FONT_BLUE}-Def",16)
    dynmultipush("Modest {CLEAR_TO 0x48}{FONT_RED}+SpAtk{FONT_NORMAL}/{FONT_BLUE}-Atk",15)
    dynmultipush("Naive  {CLEAR_TO 0x48}{FONT_RED}+Speed{FONT_NORMAL}/{FONT_BLUE}-SpDef",14)
    dynmultipush("Naughty{CLEAR_TO 0x48}{FONT_RED}+Atk{FONT_NORMAL}/{FONT_BLUE}-SpDef",4)
    dynmultipush("Quiet  {CLEAR_TO 0x48}{FONT_RED}+SpAtk{FONT_NORMAL}/{FONT_BLUE}-Speed",17)
    dynmultipush("Quirky {CLEAR_TO 0x48}Neutral",24)
    dynmultipush("Rash   {CLEAR_TO 0x48}{FONT_RED}+SpAtk{FONT_NORMAL}/{FONT_BLUE}-SpDef",19)
    dynmultipush("Relaxed{CLEAR_TO 0x48}{FONT_RED}+Def{FONT_NORMAL}/{FONT_BLUE}-Speed",7)
    dynmultipush("Sassy  {CLEAR_TO 0x48}{FONT_RED}+SpDef{FONT_NORMAL}/{FONT_BLUE}-Speed",22)
    dynmultipush("Serious{CLEAR_TO 0x48}Neutral",12)
    dynmultipush("Timid  {CLEAR_TO 0x48}{FONT_RED}+Speed{FONT_NORMAL}/{FONT_BLUE}-Atk",10)
    dynmultistack(0, 0, FALSE, 5, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
    if (var(VAR_RESULT) == MULTI_B_PRESSED) {
        return
    }
    special (SetHiddenNature)
    msgbox(format("{STR_VAR-1}'s nature has been changed!"))
    closemessage
    release
    end
}

script ResetEVs {
    special(ChoosePartyMon)
    waitstate
    if (var(VAR_0x8004) == PARTY_NOTHING_CHOSEN) {
        release
        end
    }
    copyvar(PARTY_MON, VAR_0x8004)
    bufferpartymonnick(STR_VAR_1, PARTY_MON)
    // TODO reset EVs
    msgbox(format("I have reset all of {STR_VAR_1}'s EVs!"))
    closemessage
    release
    end
}

script SwapGender {
    special(ChoosePartyMon)
    waitstate
    if (var(VAR_0x8004) == PARTY_NOTHING_CHOSEN) {
        release
        end
    }
    if (var(VAR_0x8004) == SPECIES_COMBEE   ||
        var(VAR_0x8004) == SPECIES_SALANDIT ||
        var(VAR_0x8004) == SPECIES_KIRLIA   ||
        var(VAR_0x8004) == SPECIES_BURMY    ||
        var(VAR_0x8004) == SPECIES_ESPURR   ||
        var(VAR_0x8004) == SPECIES_LECHONK  ||
        var(VAR_0x8004) == SPECIES_BASCULIN_WHITE_STRIPED) {
        copyvar(PARTY_MON, VAR_0x8004)
        bufferpartymonnick(STR_VAR_1, PARTY_MON)
        // TODO set gender to opposite
        msgbox(format("{STR_VAR_1}'s gender has been changed!"))
    }
    else {
        msgbox(format("I'm sorry, I cannot change this Pokémon."))
    }
    closemessage
    release
    end
}

script LowerIVs {
    special(ChoosePartyMon)
    waitstate
    if (var(VAR_0x8004) == PARTY_NOTHING_CHOSEN) {
        release
        end
    }
    copyvar(PARTY_MON, VAR_0x8004)
    bufferpartymonnick(STR_VAR_1, PARTY_MON)
    dynmultipush("HP", STAT_HP)
    dynmultipush("Attack", STAT_ATK)
    dynmultipush("Defense", STAT_DEF)
    dynmultipush("Sp. Atk", STAT_SPATK)
    dynmultipush("Sp. Def", STAT_SPDEF)
    dynmultipush("Speed", STAT_SPEED)
    dynmultistack(0, 0, FALSE, 6, FALSE, 0, 0)
    if (var(VAR_RESULT) == MULTI_B_PRESSED) {
        return
    }
    copyvar(MON_STAT, VAR_RESULT)
    // TODO set chosen stat IV to 0
    msgbox(format("{STR_VAR_1}'s {STR_VAR_2} IV has been lowered!"))
    closemessage
    release
    end
}
