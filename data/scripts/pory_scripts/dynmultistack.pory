// Makes pushing checked items to a dynmultistack simpler.

// Example:

// const PUSH_TO_DYNMULTISTACK_IF_IN_BAG = VAR_TEMP_8

// ...

// setvar(PUSH_TO_DYNMULTISTACK_IF_IN_BAG, ITEM_POTION)
// call(_Common_EventScript_PushItemToDynmultistackIfInBag)
// dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_SHOW_ITEM)

const PUSH_TO_DYNMULTISTACK_IF_IN_BAG = VAR_TEMP_8

script _Common_EventScript_PushItemToDynmultistackIfInBag {
  checkitem(PUSH_TO_DYNMULTISTACK_IF_IN_BAG)
  if (var(VAR_RESULT) == TRUE) {
    bufferitemname(STR_VAR_1, PUSH_TO_DYNMULTISTACK_IF_IN_BAG)
    dynmultipush("{STR_VAR_1}", PUSH_TO_DYNMULTISTACK_IF_IN_BAG)
  }
}
