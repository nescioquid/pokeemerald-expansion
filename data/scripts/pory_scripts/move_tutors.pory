// Originally Swagger
script _SlateportCity_PokemonFanClub_EventScript_MoveTutor {
  lock
  faceplayer
  if (!flag(FLAG_MOVE_TUTOR_MOVES_RANDOMIZED)) {
    call(_Common_EventScript_RandomMoveTutorMoveGenerator)
    setflag(FLAG_MOVE_TUTOR_MOVES_RANDOMIZED)
  }
  if (var(VAR_RANDOMIZED_MOVE_TUTOR_MOVE_1) == MOVE_WATER_PULSE) {
    call(_Common_EventScript_WaterPulseTutor)
  }
  if (var(VAR_RANDOMIZED_MOVE_TUTOR_MOVE_1) == MOVE_BULLET_SEED) {
    call(_Common_EventScript_BulletSeedTutor)
  }
  if (var(VAR_RANDOMIZED_MOVE_TUTOR_MOVE_1) == MOVE_GIGA_DRAIN) {
    call(_Common_EventScript_GigaDrainTutor)
  }
  if (var(VAR_RANDOMIZED_MOVE_TUTOR_MOVE_1) == MOVE_IRON_TAIL) {
    call(_Common_EventScript_IronTailTutor)
  }
  if (var(VAR_RANDOMIZED_MOVE_TUTOR_MOVE_1) == MOVE_SHOCK_WAVE) {
    call(_Common_EventScript_ShockWaveTutor)
  }
  if (var(VAR_RANDOMIZED_MOVE_TUTOR_MOVE_1) == MOVE_SNATCH) {
    call(_Common_EventScript_SnatchTutor)
  }
  release
  end
}

script _MauvilleCity_EventScript_RolloutTutor {
  lock
  faceplayer
  if (!flag(FLAG_TEMP_1)) {
    if (!msgbox(MoveTutor_Text_RolloutTeach, MSGBOX_YESNO)) {
      msgbox(MoveTutor_Text_RolloutDeclined)
      release
      end
    }
    msgbox(MoveTutor_Text_RolloutWhichMon)
    setorcopyvar(VAR_0x8005, MOVE_ROLLOUT)
    call(_MoveTutor_EventScript_OpenPartyMenu)
    if (var(VAR_RESULT) == 0) {
      msgbox(MoveTutor_Text_RolloutDeclined)
      release
      end
    }
    setflag(FLAG_TEMP_1)
  }
  msgbox(MoveTutor_Text_RolloutTaught)
  release
  end
}

